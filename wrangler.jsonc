{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pmo-osai",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_als"
	],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	// D1 บน Cloudflare (สร้างแล้ว ภูมิภาค APAC)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pmo-db",
			"database_id": "e76ffa43-f44b-4695-8bcd-6ae37ac50353",
			"migrations_dir": "drizzle"
		}
	]
}
